    {
      "parameters": {
        "jsCode": "// Get caption/metadata from the Google Sheets row\nconst driveData = $('Get row(s) in sheet').first().json;\n\n// Get file URL from the HTTP upload node (uguu.se)\nconst httpData = $('HTTP Request').first().json;\nconst uploadedUrl = httpData.body.files[0].url;\n\nconst fullText = driveData['Caption'] || '';\nconst hashtagsMatch = fullText.match(/#[\\\\w]+/g) || [];\nconst captionText = fullText.replace(/#[\\\\w]+/g, '').trim();\n\n// Use 'Content Type' field from Sheets\nconst contentType = (driveData['Content Type'] || '').toLowerCase();\nconst isVideo = contentType === 'video';\n\nreturn [{\n  json: {\n    caption: captionText,\n    hashtags: hashtagsMatch.join(' '),\n    media_type: isVideo ? 'video' : 'image',\n    uploaded_url: uploadedUrl,\n    name: driveData['ID'] || ''\n  }\n}];"
      },
